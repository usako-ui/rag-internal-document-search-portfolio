# ============================================================
# 環境変数テンプレート
#
# 使い方：このファイルを .env.local としてコピーし、各値を設定する。
#   cp .env.example .env.local
#
# 【重要】.env.local は絶対にGitへコミットしないこと（.gitignore で除外済み）
#         環境変数を追加したら、このファイルもキー名だけ同期更新すること
# ============================================================

# --- Supabase ---
# プロジェクトURL（Supabaseダッシュボード > Project Settings > Data API）
# NEXT_PUBLIC_ 接頭辞のためブラウザへ露出する。公開して問題ない値のみ設定すること
NEXT_PUBLIC_SUPABASE_URL=

# 匿名キー（anon key）。RLSが効く前提の公開キーのためクライアント利用可
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# サービスロールキー。RLSを迂回し全データへアクセスできる管理キー
# 【厳禁】NEXT_PUBLIC_ を付けないこと。サーバーサイド（API Route）のみで使用する
SUPABASE_SERVICE_ROLE_KEY=

# --- 社内メールドメイン制限（要件F-06） ---
# このドメイン以外のメールアドレスではログインできない（例：techbridge.co.jp）
# `@` は付けても付けなくてもよい。サブドメインは別ドメイン扱いで拒否する
# 【重要】未設定の場合はすべてのログインを拒否する（設定漏れで社外アドレスを
#         素通りさせないため）。Vercelの環境変数にも必ず設定すること
# 【重要】この値を設定・変更したら必ず `npm run sync:allowed-domain` を実行すること。
#         Supabaseを直接叩く経路を塞ぐため、同じ値をDB（app_config）にも持たせている。
#         同期し忘れると「ログインはできるのに文書が0件」になる
ALLOWED_EMAIL_DOMAIN=

# --- 検証用ログインユーザー（開発環境のみ） ---
# Supabase Auth のテストユーザー。ログイン画面・APIの認証確認に使用する
# 値を設定後 `npm run create:test-user` で作成・パスワード更新ができる
# 【厳禁】本番環境では使用しないこと。認証情報を .env.local 以外へ書かないこと
TEST_USER_EMAIL=
TEST_USER_PASSWORD=

# --- Gemini API ---
# 回答生成（gemini-2.5-flash）とEmbedding生成に使用する
# 【厳禁】サーバーサイドのみで使用し、クライアントへ露出させないこと
GEMINI_API_KEY=
