# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.js
.yarn/install-state.gz

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local env files
# 【厳禁】.env.local は絶対にコミットしない
# （Supabase service_role キー・Gemini APIキーを含むため、漏洩すると社内文書へ外部からアクセス可能になる）
.env.local
.env*.local

# 取り込み対象のPDFと生成物
# 社内文書そのものをリポジトリへ入れないため、data/ 配下はGit管理しない
# （data/sample-pdfs/ に実文書、data/test/ に動作確認用の生成PDFを置く）
/data/

# vercel
.vercel

# Claude Code のローカル設定（各自の権限許可設定のため共有しない）
.claude/settings.local.json
.claude/settings.json

# typescript
*.tsbuildinfo
next-env.d.ts

# ============================================================
# ポートフォリオ公開のためGit管理から外すファイル
#
# いずれも「動かすために必要なもの」ではなく、開発時の作業記録・設計素材。
# 外しても、README・docs/ 配下の納品資料だけでセットアップと運用ができる。
# ============================================================

# 開発中のタスク管理・要確認事項の記録
# 個人名・日々のやり取りが含まれるため公開しない
tasks.md

# Architectが生成した作業指示書
# 個人名とSupabaseプロジェクトURLが含まれるため公開しない
agent-brief.md

# 設計初期のUIイメージ（Boltで作成したモックアップ）
# 実装済みのUIは docs/screenshots/ にあるため、公開資料としては不要
/bolt-reference/
